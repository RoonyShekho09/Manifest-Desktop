import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE DispatchRecord (
    id TEXT NOT NULL PRIMARY KEY,
    carType TEXT NOT NULL,
    isInside INTEGER AS Boolean NOT NULL DEFAULT 0,
    price INTEGER AS Int NOT NULL,
    type TEXT NOT NULL,
    vehicleNumber TEXT NOT NULL,

    driver_id TEXT NOT NULL,
    driver_name TEXT NOT NULL,
    driver_phone TEXT NOT NULL,
    driver_destination TEXT NOT NULL,

    office_id TEXT NOT NULL,
    office_name TEXT NOT NULL,

    line_id TEXT NOT NULL,
    line_name TEXT NOT NULL,
    blocked INTEGER AS Boolean NOT NULL DEFAULT 0
);

insertDispatch:
INSERT OR REPLACE INTO DispatchRecord (
    id,
    carType,
    isInside,
    price,
    type,
    vehicleNumber,
    driver_id,
    driver_name,
    driver_phone,
    driver_destination,
    office_id,
    office_name,
    line_id,
    line_name,
    blocked
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

queryDispatches:
SELECT * FROM DispatchRecord;

hasDispatches:
SELECT EXISTS(SELECT 1 FROM DispatchRecord LIMIT 1);